#1. Build the application

#Select a Maven image with Java 21
FROM maven:3.9-eclipse-temurin-21 AS build

#Set the working directory inside the container
WORKDIR /workspace

#Copy POMs into the build env
COPY pom.xml .
COPY contacts-api/pom.xml contacts-api/pom.xml
COPY contacts-reporter/pom.xml contacts-reporter/pom.xml

#Copy source code for both modules
COPY contacts-api contacts-api
COPY contacts-reporter contacts-reporter

#Build contacts-api and its required Maven modules
RUN mvn -f pom.xml -pl contacts-api -am package -DskipTests


#2. Run the application

#Start a separate stage containing the Java runtime
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24 AS runtime

#Set the working directory inside the container
WORKDIR /deployments

#Copy only the packaged application from the build stage
COPY --from=build --chown=185 /workspace/contacts-api/target/quarkus-app/lib/ lib/
COPY --from=build --chown=185 /workspace/contacts-api/target/quarkus-app/*.jar ./
COPY --from=build --chown=185 /workspace/contacts-api/target/quarkus-app/app/ app/
COPY --from=build --chown=185 /workspace/contacts-api/target/quarkus-app/quarkus/ quarkus/

#Application listens on port 8080
EXPOSE 8080

#Ensure the application doesn't run as root
USER 185

#Java startup script to pass to the JVM
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
#Tells Red Hat Java container's startup script which JAR file to launch
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

#Start the packaged Quarkus application
ENTRYPOINT ["/opt/jboss/container/java/run/run-java.sh"]